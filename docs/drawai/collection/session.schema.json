{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "drawai-private-session-v1"
    },
    "protocol_version": {
      "const": "drawai-private-protocol-v1"
    },
    "session_id": {
      "type": "string",
      "pattern": "^session_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "participant_id": {
      "type": "string",
      "pattern": "^[PM][0-9]{3}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "pilot",
        "main"
      ]
    },
    "input_device": {
      "type": "string",
      "enum": [
        "mouse",
        "touch",
        "pen"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "drawai-consent-v1"
        },
        "record_ref": {
          "type": "string",
          "pattern": "^C-[A-Z0-9-]{3,32}$"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "training": {
          "const": true
        },
        "evaluation": {
          "const": true
        },
        "kaggle_publication": {
          "const": true
        }
      },
      "required": [
        "version",
        "record_ref",
        "confirmed_at",
        "training",
        "evaluation",
        "kaggle_publication"
      ]
    },
    "samples": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "drawai-private-sample-v1"
          },
          "protocol_version": {
            "const": "drawai-private-protocol-v1"
          },
          "sample_id": {
            "type": "string",
            "pattern": "^sample_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "participant_id": {
            "type": "string",
            "pattern": "^[PM][0-9]{3}$"
          },
          "session_id": {
            "type": "string",
            "pattern": "^session_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "stage": {
            "type": "string",
            "enum": [
              "pilot",
              "main"
            ]
          },
          "label": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "repetition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "input_device": {
            "type": "string",
            "enum": [
              "mouse",
              "touch",
              "pen"
            ]
          },
          "actual_pointer_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "mouse",
                "touch",
                "pen"
              ]
            }
          },
          "source_kind": {
            "const": "human-collected"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time"
          },
          "drawing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version",
              "coordinate_system",
              "canvas",
              "strokes",
              "reference_label",
              "source"
            ],
            "properties": {
              "schema_version": {
                "const": "drawai-strokes-v1"
              },
              "coordinate_system": {
                "const": "canvas-y-down"
              },
              "canvas": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "width": {
                    "const": 400
                  },
                  "height": {
                    "const": 400
                  }
                },
                "required": [
                  "width",
                  "height"
                ]
              },
              "strokes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8192,
                  "items": {
                    "$ref": "#/$defs/point"
                  }
                }
              },
              "reference_label": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "user"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        },
        "required": [
          "schema_version",
          "protocol_version",
          "sample_id",
          "participant_id",
          "session_id",
          "stage",
          "label",
          "repetition",
          "input_device",
          "actual_pointer_types",
          "source_kind",
          "collected_at",
          "drawing"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "session_id",
    "participant_id",
    "stage",
    "input_device",
    "started_at",
    "consent",
    "samples"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DrawAI private collection session v1",
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        }
      }
    }
  }
}
