{
  "name": "drawai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:app": "playwright test --config playwright.drawai-app.config.ts",
    "test:release": "playwright test --config playwright.drawai-release.config.ts",
    "test:integration": "playwright test --config playwright.drawai-integration.config.ts"
  },
  "dependencies": {
    "onnxruntime-web": "1.20.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "typescript": "5.7.3",
    "vite": "6.4.3"
  }
}
