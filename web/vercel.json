{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:public",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/drawai", "destination": "/index.html" },
    { "source": "/drawai/", "destination": "/index.html" },
    { "source": "/drawai/compare", "destination": "/index.html" },
    { "source": "/drawai/compare/", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/models/drawai-paint35-swin-v1/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
